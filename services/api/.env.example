# Copy to .env for local runs outside Docker. Never commit the real .env file.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://marec:marec_local_dev_only@localhost:5432/marec
# Local-only placeholder. Staging and production require a random value of 32+ characters.
JWT_SECRET=change-me-local-dev-only-0123456789abcdef
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Comma-separated list of allowed website origins. Empty means no cross-origin access.
CORS_ORIGINS=
