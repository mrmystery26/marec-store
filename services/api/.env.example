# Copy to .env for local runs outside Docker. Never commit the real .env file.
ENVIRONMENT=local
# Matches infra/docker-compose.yml (a throwaway database on your own computer).
DATABASE_URL=postgresql+psycopg://marec:marec_local_dev_only@localhost:5432/marec
# Make your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Staging and production refuse to start without a random value of 32+ characters.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Comma-separated list of allowed website origins. Empty means no cross-origin access.
CORS_ORIGINS=

# The public address of this API (Google sends the browser back to it after sign-in).
PUBLIC_API_BASE_URL=http://localhost:8000

# Sign in with Google (leave both empty to hide the button). See docs/SETUP_ACCOUNTS.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email through Resend (leave empty to send no email). EMAIL_FROM needs a verified domain.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFY_EMAIL=
# Comma-separated emails that become super administrators when they sign in (verified only).
BOOTSTRAP_ADMIN_EMAILS=

# Developers may only upload free demos for now.
DEMO_ONLY=true
DEMO_MAX_BUILD_MB=1024
DEMO_MAX_GAMES_PER_STUDIO=5
